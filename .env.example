# =============================================================================
# erekini — environment template
# Copy to .env.local and fill in values from your Supabase / Resend dashboards.
# Never commit real secrets.
# =============================================================================

# App
NEXT_PUBLIC_APP_NAME=erekini
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — webhooks, admin jobs. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Auth: configure Google OAuth in Supabase Dashboard → Authentication → Providers.
# Redirect allow-list must include: ${NEXT_PUBLIC_SITE_URL}/auth/callback
# GOOGLE_CLIENT_ID=          # prefer Supabase dashboard only
# GOOGLE_CLIENT_SECRET=

# Resend (Phase 2 — email send)
RESEND_API_KEY=
RESEND_FROM_EMAIL=rekini@your-domain.lv

# UR (Uzņēmumu reģistrs) open data (Phase 1)
UR_OPEN_DATA_BASE_URL=
# UR_API_KEY=                # only if the chosen source requires one
